generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt   @unique
  username     String?
  firstName    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  character    Character?
}

model Character {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  user                User     @relation(fields: [userId], references: [id])
  /// Снимок для аналитики и отладки. Источник истины —
  /// calculateLevel(strength, agility, endurance, bonusLevels).
  /// Любая запись статов обязана обновить это поле.
  level               Int      @default(1)
  energy              Int      @default(100)
  lastEnergyUpdate    DateTime @default(now())
  endurance           Int      @default(10)
  strength            Int      @default(10)
  agility             Int      @default(10)
  luck                Int      @default(0)
  // Уровни, полученные НЕ от статов — прибавляются дискретными событиями
  // (сейчас только убийство босса, +1, см. /run/battle-result), НИКОГДА не
  // пересчитываются из статов. Складывается с чисто-статовой частью внутри
  // calculateLevel.
  bonusLevels         Int      @default(0)
  strengthProgress    Float    @default(0)   // accumulated raw attack damage toward next Strength point
  enduranceProgress   Float    @default(0)   // accumulated raw damage taken toward next Endurance point
  agilityProgress     Float    @default(0)   // accumulated raw skill damage + healed amount toward next Agility point
  gold                Int      @default(0)
  trophies            Int      @default(0)
  crystals            Int      @default(0)
  // Запас зелий по тирам, по колонке на тир (см. src/potions.ts —
  // POTION_TIERS, он же источник силы лечения/цены/уровня открытия).
  // Пять скалярных колонок, а не Json/отдельная таблица: тиров ровно пять и
  // это фиксировано каталогом, а счётчику нужны атомарные +1/-1 в том же
  // update, где пишутся золото и трофеи.
  // potionT1 по умолчанию 3 — сохраняем нынешний онбординг (столько же
  // давала старая potionCharges), остальные тиры стартуют пустыми.
  potionT1            Int      @default(3)
  potionT2            Int      @default(0)
  potionT3            Int      @default(0)
  potionT4            Int      @default(0)
  potionT5            Int      @default(0)
  // Расходники — по одной колонке на вид (каталог: src/consumables.ts /
  // server/src/consumables.ts, CONSUMABLES). Скаляры, а не Json и не отдельная
  // таблица, по той же причине, что и potionT1..T5 выше: видов мало и они
  // фиксированы каталогом, а счётчику нужны атомарные increment/decrement в том
  // же UPDATE, где пишется золото. Новый расходник = новая колонка + миграция.
  whetstones          Int      @default(0)
  charms              Int      @default(0)
  // Книги скиллов — по колонке на книгу, пять книг на пять скиллов (каталог
  // CONSUMABLES, id book_*). Единственное отличие от расходников выше: книга не
  // едет в забег (runSlot: false) и списываться будет при применении к скиллу,
  // которое ещё не реализовано, — колонки пока только растут при покупке.
  // Не Json и не таблица — по той же причине, что potionT1..T5 и whetstones:
  // видов ровно столько, сколько в каталоге, а счётчику нужен атомарный
  // increment в том же UPDATE, где списывается золото.
  bookFire            Int      @default(0)
  bookIce             Int      @default(0)
  bookBleed           Int      @default(0)
  bookHeal            Int      @default(0)
  bookDash            Int      @default(0)
  // Страницы книг — по колонке на страницу, пять на пять навыков (каталог
  // src/scrolls.ts / server/src/scrolls.ts, id scroll_*). Три страницы
  // складываются в книгу (POST /character/assemble-book), одна продаётся за
  // SCROLL_SELL_PRICE (POST /character/sell-scroll).
  // ⚠️ В МАГАЗИНЕ СТРАНИЦ НЕТ — решение дизайнера: они только выпадают в
  // забегах (POST /run/finish-explore), поэтому колонки растут ТОЛЬКО дропом.
  // Ячейку сумки страница НЕ тратит (docs/items.md, «ПРАВИЛО ВМЕСТИМОСТИ»): их
  // копятся десятки, как зелий, и терять их при переполнении было бы
  // несоразмерно.
  // Не Json и не таблица — та же причина, что у potionT1..T5, книг и
  // расходников: видов ровно столько, сколько в каталоге, а счётчику нужны
  // атомарные increment/decrement в том же UPDATE, где закрывается забег.
  scrollFire          Int      @default(0)
  scrollIce           Int      @default(0)
  scrollBleed         Int      @default(0)
  scrollHeal          Int      @default(0)
  scrollDash          Int      @default(0)
  // Предметы классов (каталог src/classItems.ts / server/src/classItems.ts,
  // миграция 20261018120000_class_item_stock_add). Растут ТОЛЬКО дропом на
  // финише забега: в «Убежище» их нет. Убывают только продажей
  // (POST /character/sell-class-item) — классов, на которые их тратить, в игре
  // ещё нет (docs/classes.md).
  // soulShards — Осколки души: падают с 10 уровня, ячейку сумки НЕ тратят (как
  // страницы), продаются за 50.
  // renounceSeals — Печати отречения: падают только с босса, отдельным броском
  // 5%, ячейку ТРАТЯТ (одна на вид, как книга), продаются за 500.
  // Колонки, а не строки InventoryItem и не Json — та же причина, что у страниц
  // и книг: счётчику нужен атомарный increment в ТОМ ЖЕ UPDATE, что закрывает
  // забег, а у Item (таблица снаряжения) нет ни слота, ни тира для них.
  soulShards          Int      @default(0)
  renounceSeals       Int      @default(0)
  // Мастер (docs/crafter.md, миграция 20261029120000_crafter_items_add):
  // склад сырья, Слитков и колец — те же колонки-счётчики, что выше (каталог
  // classItems.ts), и гнёзда колец Дланей иного места (id колец, не больше двух;
  // надетое кольцо со склада уходит). Читать гнёзда через ringSlotsOf (runState.ts).
  darkClots           Int      @default(0)
  starPollen          Int      @default(0)
  otherIngots         Int      @default(0)
  ringSaving          Int      @default(0)
  ringSkillSearch     Int      @default(0)
  ringAsh             Int      @default(0)
  ringOverflow        Int      @default(0)
  ringProspector      Int      @default(0)
  ringReturn          Int      @default(0)
  ringSlots           String[] @default([])
  // Класс героя (каталог src/heroClasses.ts / server/src/heroClasses.ts,
  // миграция 20261020120000_hero_class_add). Выбирается у Отшельника с 10
  // уровня, возвышается до второй ступени своей ветки с 30, снимается
  // отречением за Печать (POST /character/choose-class / ascend-class /
  // renounce-class). Эффектов в бою пока нет — класс хранится и показывается.
  // classId — ветка: 'ghoul' | 'sorcerer' | 'duelist', null — класса нет.
  // classTier — ступень: 1 или 2, 0 — класса нет. Пара читается ТОЛЬКО через
  // heroClassOf (runState.ts): колонка-строка схемой не проверяется, и
  // испорченная пара (класс без ступени, ступень без класса, чужой id) там
  // громкая, а не тихое «класса нет».
  // Строка, а не enum Postgres: id классов — строки каталога, как id книг и
  // страниц, и сверяет их один parseHeroClassId на обеих сторонах.
  classId             String?
  classTier           Int      @default(0)
  // Ежедневные задания (каталог src/quests.ts / server/src/quests.ts,
  // docs/daily-quests.md, миграция 20261026120000_daily_quests_add).
  // hunterBadges — значки охотника, валюта заданий: растут ТОЛЬКО наградой за
  // выполненное задание (финиш живой вылазки), тратить их пока не на что.
  // rp — RP, +1 за каждое выполненное задание; тратить тоже пока не на что.
  // Скаляры, а не Json: награда — increment в ТОЙ ЖЕ условной записи, что
  // закрывает забег, как у страниц и предметов классов.
  // questState — набор заданий, активное задание с прогрессом, таймер набора и
  // замена. null — набора ещё не было (герой ниже 5 уровня или до этой правки).
  // Json, а не таблица: читается и пишется целиком, одной условной записью с
  // фильтром по прежнему значению. Читать ТОЛЬКО через readQuestState
  // (questState.ts): испорченное значение там громкое, а не «набора нет».
  hunterBadges        Int      @default(0)
  rp                  Int      @default(0)
  questState          Json?
  // Уровень КАЖДОГО навыка, по колонке на навык. Растёт на 1 за применённую
  // книгу (POST /character/upgrade-skill) и НИКОГДА не убывает: «забыть» навык
  // снимает его из equippedSkills, но уровень остаётся — так решено дизайном.
  // Старт 1, а не 0: навык существует с первого уровня, ноль означал бы «навыка
  // нет», а это выражено отсутствием в equippedSkills и пустым складом книг.
  // Уровень УСИЛИВАЕТ навык с 02.10.2026: урон и лечение умножаются на
  // skillPowerMult(уровень) = 1 + √(уровень − 1) / 32 (общая пара
  // src/skillLevels.ts <-> server/src/skillLevels.ts). Перезарядки, длительность
  // стана и число тиков он не трогает вовсе.
  // Колонка на навык, а не Json — та же причина, что у potionT1..T5 и книг:
  // навыков ровно пять по каталогу, а счётчику нужен атомарный increment в том
  // же UPDATE, где списывается книга.
  // Купленные улучшения («закалки»), по счётчику на вид (каталог:
  // src/upgrades.ts / server/src/upgrades.ts). Цена следующего считается ОТ
  // счётчика (round(300 × 1.2^N)), потолка нет, поэтому хранится именно
  // количество, а не готовая прибавка: прибавку даёт каталог (upgradeBonus), и
  // правка шага не требует переливки данных.
  attackUpgrades      Int      @default(0)
  armorUpgrades       Int      @default(0)
  skillLevelFireball  Int      @default(1)
  skillLevelIceball   Int      @default(1)
  skillLevelSlash     Int      @default(1)
  skillLevelHeal      Int      @default(1)
  skillLevelDash      Int      @default(1)
  // Результативные применения навыка, накопленные в счёт СЛЕДУЮЩЕГО уровня
  // (миграция 20261002120000_skill_uses_add). Порог — skillUsesThreshold
  // (общая пара skillLevels.ts), при его пересечении уровень +1, а порог
  // вычитается — значит здесь лежит ОСТАТОК, а не всего применений за
  // историю. Пишутся ТОЛЬКО на закрытии забега (финиш и логин, одним
  // кодом — см. applySkillUsesGrowth в game.ts), источник —
  // currentRun.progress.skillUses, который кладёт клиент.
  // Книга (+1 уровень) эти счётчики НЕ сбрасывает — решение дизайнера.
  skillUsesFireball   Int      @default(0)
  skillUsesIceball    Int      @default(0)
  skillUsesSlash      Int      @default(0)
  skillUsesHeal       Int      @default(0)
  skillUsesDash       Int      @default(0)
  equippedSkills      String[] @default([])
  currentRun          Json?    // активный забег: { rooms, index }; null = забега нет
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  inventoryItems      InventoryItem[]
  idempotencyKeys     IdempotencyKey[]
}

model Item {
  id            String   @id @default(cuid())
  slot          String   // "weapon" | "armor" | "helmet" | "boots" | "gloves" | "amulet"
  tier          Int      // 1-6, same range for all six slots (see CLAUDE.md "СПИСОК ПРЕДМЕТОВ")
  nameRu        String   // Russian display name, e.g. "Стальной длинный меч"
  iconPath      String   // e.g. "weapons/weapon_07.png"
  levelRequired Int      // minimum character level to equip — tier * 5
  damage        Int?     // weapon only
  armor         Int?     // armor/helmet/gloves only
  moveSpeed     Float?   // boots only — PERCENT bonus (e.g. 5 = +5% move speed), not a multiplier
  luck          Int?     // amulet only
  description   String?  // Russian flavor text (see CLAUDE.md "СПИСОК ПРЕДМЕТОВ") — not rendered by any UI yet
  inventoryItems InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  equipped    Boolean   @default(false)
  acquiredAt  DateTime  @default(now())

  @@index([characterId])
}

// Ключ идемпотентности: запрос с таким ключом уже применён, повтор с тем же
// ключом не применяется второй раз (миграция 20261015120000_idempotency_keys_add).
//
// Пишется в ТОЙ ЖЕ транзакции, что и само действие, и ПЕРВЫМ: второй запрос с
// тем же ключом упирается в уникальный индекс (characterId, key), его
// транзакция откатывается целиком, и он получает ответ «уже сделано», а не
// второе списание. Отказ по существу («не хватило золота») ключ НЕ тратит —
// транзакция откатывается вместе со строкой ключа.
//
// Кто пишет: покупки (buy-potion / buy-consumable / buy-upgrade, ключ из тела —
// requestId) и финиш забега (ключ `finish:<runId>`, в response — итог забега,
// чтобы повтор потерянного финиша получил те же числа, а не 400).
//
// Строки старше суток удаляются при записи нового ключа того же персонажа
// (pruneIdempotencyKeys, routes/run.ts): клиент держит ключ для повтора
// минуты, а не дни.
model IdempotencyKey {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  key         String
  // Какая ручка применила ключ. Тот же ключ на другой ручке — ошибка клиента,
  // а не повтор: отвечать ему чужим «уже сделано» нельзя.
  endpoint    String
  // Сохранённый ответ — только там, где его нельзя пересчитать (итог финиша).
  // Покупки при повторе отвечают ТЕКУЩИМ состоянием из БД, им ответ не нужен.
  response    Json?
  createdAt   DateTime  @default(now())

  @@unique([characterId, key])
  @@index([characterId, createdAt])
}
